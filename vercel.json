{
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    { "path": "/api/cron/update-stock-prices", "schedule": "* * * * *" },
    { "path": "/api/cron/update-crypto-prices", "schedule": "0 */3 * * *" }
  ]
}
