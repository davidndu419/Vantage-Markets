rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the user matches the requested document ID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if the user has an admin role in the database
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function hasValidTier(data) {
      return data.keys().hasAny(['tier'])
        && (data.tier == 'T1' || data.tier == 'T2' || data.tier == 'T3');
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // New profiles must use the complete standard-user defaults.
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll([
          'uid',
          'name',
          'email',
          'createdAt',
          'role',
          'tier',
          'withdrawalFrozen',
          'freezeReason',
          'preferredMarket',
          'onboardingCompleted'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'user'
        && request.resource.data.tier == 'T1'
        && request.resource.data.withdrawalFrozen == false
        && request.resource.data.freezeReason == ''
        && request.resource.data.preferredMarket == null
        && request.resource.data.onboardingCompleted == false;
      // Owners may edit profile/onboarding fields, but never role or freeze controls.
      allow update: if (
        isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && (
          (resource.data.keys().hasAny(['tier'])
            && request.resource.data.tier == resource.data.tier)
          || (!resource.data.keys().hasAny(['tier'])
            && request.resource.data.tier == 'T1')
        )
        && request.resource.data.withdrawalFrozen == resource.data.withdrawalFrozen
        && request.resource.data.freezeReason == resource.data.freezeReason
      ) || (isAdmin() && hasValidTier(request.resource.data));
      allow delete: if isAdmin();
    }

    // 2. Assets collection
    match /assets/{assetId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Asset Prices collection
    match /assetPrices/{ticker} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Holdings collection
    match /holdings/{holdingId} {
      // Users can read their own holdings. Only admin can modify them.
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // 5. Transactions collection
    match /transactions/{txId} {
      // Users can read their own transactions. Admins can read all transactions.
      allow read: if isAdmin() || (
        isAuthenticated()
        && resource.data.userId == request.auth.uid
        && resource.data.visibleToUser == true
        && resource.data.type != 'admin_credit'
      );
      // Users can create transaction requests which start in pending status and visibleToUser
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && (!request.resource.data.keys().hasAny(['visibleToUser']) || request.resource.data.visibleToUser == true);
      // Only admins can update transaction statuses (approve/decline)
      allow update, delete: if isAdmin();
    }

    // 6. Deposit Addresses collection
    match /depositAddresses/{addrId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 7. Support Chats collection
    match /supportChats/{chatId} {
      // Chat ID is the user ID. Users can read/write their own chat summary, admins can access all.
      allow read, write: if isOwner(chatId) || isAdmin();
    }

    // 8. Support Messages collection
    match /supportMessages/{msgId} {
      // Users can read their own support messages. Admins can read all.
      allow read: if isAuthenticated() && (resource.data.chatId == request.auth.uid || isAdmin());
      // Users can append messages to their own chat thread.
      allow create: if isAuthenticated() && (
        (request.resource.data.chatId == request.auth.uid && request.resource.data.senderId == request.auth.uid && request.resource.data.senderRole == 'user')
        || isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // 9. Admin Credits collection
    match /adminCredits/{creditId} {
      // Only administrators have access to admin credit audit logs.
      allow read, write: if isAdmin();
    }

    match /adminHoldingActions/{actionId} {
      allow read, write: if isAdmin();
    }
  }
}
